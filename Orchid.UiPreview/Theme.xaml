<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Orchid.UiPreview.Theme">
    <!-- Tokens from docs/orchid-design/UI-SPEC.md. Drawings read the same tokens through PreviewColors. -->
    <Color x:Key="BackgroundLight">#E3E4E8</Color>
    <Color x:Key="BackgroundDark">#141416</Color>
    <Color x:Key="SurfaceLight">#EDEEF1</Color>
    <Color x:Key="SurfaceDark">#1C1D21</Color>
    <Color x:Key="SubtleSurfaceLight">#E6E7EB</Color>
    <Color x:Key="SubtleSurfaceDark">#24252A</Color>
    <Color x:Key="TextLight">#17181C</Color>
    <Color x:Key="TextDark">#E6E7EB</Color>
    <Color x:Key="TextSecondaryLight">#4D5058</Color>
    <Color x:Key="TextSecondaryDark">#A2A4AC</Color>
    <Color x:Key="BorderLight">#C6C8CF</Color>
    <Color x:Key="BorderDark">#34363D</Color>
    <!-- Graphite neutrals for structure, steel for recorded notes, magenta only for "now": playhead, held notes and keys, recording. -->
    <Color x:Key="AccentLight">#C2185B</Color>
    <Color x:Key="AccentDark">#FF6FA6</Color>
    <Color x:Key="OnAccentLight">#FFFFFF</Color>
    <Color x:Key="OnAccentDark">#2A0716</Color>
    <Color x:Key="NoteFillLight">#CDD6E2</Color>
    <Color x:Key="NoteFillDark">#2F3B4C</Color>
    <Color x:Key="NoteStrokeLight">#4A6587</Color>
    <Color x:Key="NoteStrokeDark">#8EA5C4</Color>
    <Color x:Key="NoteTextLight">#22344B</Color>
    <Color x:Key="NoteTextDark">#D8E1EE</Color>
    <Color x:Key="SelectedFillLight">#C2185B</Color>
    <Color x:Key="SelectedFillDark">#E0407F</Color>
    <Color x:Key="SelectedStrokeLight">#7E0C3B</Color>
    <Color x:Key="SelectedStrokeDark">#FF9CC2</Color>
    <Color x:Key="SelectedTextLight">#FFFFFF</Color>
    <Color x:Key="SelectedTextDark">#1A0510</Color>
    <Color x:Key="GridBarLight">#3E4048</Color>
    <Color x:Key="GridBarDark">#A9ABB3</Color>
    <Color x:Key="GridBeatLight">#C2C5CD</Color>
    <Color x:Key="GridBeatDark">#2E3036</Color>
    <Color x:Key="GridTickLight">#7B7F89</Color>
    <Color x:Key="GridTickDark">#6C6F79</Color>
    <!-- ARGB: a translucent column over the strong beats. -->
    <Color x:Key="StrongBeatTintLight">#123E4048</Color>
    <Color x:Key="StrongBeatTintDark">#14A9ABB3</Color>
    <Color x:Key="KeyRowLight">#E2E4E9</Color>
    <Color x:Key="KeyRowDark">#212227</Color>
    <Color x:Key="BarLabelFillLight">#DADCE1</Color>
    <Color x:Key="BarLabelFillDark">#2C2D33</Color>
    <Color x:Key="BarLabelTextLight">#26282E</Color>
    <Color x:Key="BarLabelTextDark">#E1E2E7</Color>
    <Color x:Key="KeyWhiteLight">#F3F4F6</Color>
    <Color x:Key="KeyWhiteDark">#CFD1D8</Color>
    <Color x:Key="KeyBlackLight">#2A2C33</Color>
    <Color x:Key="KeyBlackDark">#2A2C33</Color>
    <Color x:Key="KeyLabelLight">#2A2C33</Color>
    <Color x:Key="KeyLabelDark">#2A2C33</Color>
    <!-- One magenta cannot contrast with both a light white key and a dark black key, so held keys have their own fills. -->
    <Color x:Key="KeyHeldLight">#C2185B</Color>
    <Color x:Key="KeyHeldDark">#B0195A</Color>
    <Color x:Key="KeyHeldBlackLight">#E0407F</Color>
    <Color x:Key="KeyHeldBlackDark">#E0407F</Color>
    <Color x:Key="KeyHeldTextLight">#FFFFFF</Color>
    <Color x:Key="KeyHeldTextDark">#FFFFFF</Color>

    <x:Double x:Key="FontCaption">11</x:Double>
    <x:Double x:Key="FontSecondary">12</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontTitle">22</x:Double>
    <x:Double x:Key="FontDisplay">28</x:Double>

    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PanelPadding">16</Thickness>

    <!-- Lucide icons (ISC, docs/orchid-design/THIRD-PARTY-NOTICES.txt) as font glyphs, so they stay on real Buttons and follow the theme. -->
    <FontImageSource x:Key="IconRefresh" FontFamily="Lucide" Glyph="&#xE145;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconPlay" FontFamily="Lucide" Glyph="&#xE13C;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconPause" FontFamily="Lucide" Glyph="&#xE12E;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconRewind" FontFamily="Lucide" Glyph="&#xE15F;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconOpenLog" FontFamily="Lucide" Glyph="&#xE247;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconRecord" FontFamily="Lucide" Glyph="&#xE076;" Size="16" Color="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
    <FontImageSource x:Key="IconStop" FontFamily="Lucide" Glyph="&#xE167;" Size="16" Color="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
    <FontImageSource x:Key="IconClose" FontFamily="Lucide" Glyph="&#xE1B2;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconFlower" FontFamily="Lucide" Glyph="&#xE2D4;" Size="24" Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>
    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="Label" BasedOn="{StaticResource SecondaryLabel}">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleSurfaceLight}, Dark={StaticResource SubtleSurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="BorderColor" Value="Transparent" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Blocks of the beat bars: bar color = strong, tick color = the single block of a weak beat, empty = unused slot.
         Not the accent: magenta is reserved for "now". -->
    <Style x:Key="BeatBlockOn" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GridBarLight}, Dark={StaticResource GridBarDark}}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="BeatBlockWeak" TargetType="Button" BasedOn="{StaticResource BeatBlockOn}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GridTickLight}, Dark={StaticResource GridTickDark}}" />
    </Style>
    <Style x:Key="BeatBlockOff" TargetType="Button" BasedOn="{StaticResource BeatBlockOn}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleSurfaceLight}, Dark={StaticResource SubtleSurfaceDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleSurfaceLight}, Dark={StaticResource SubtleSurfaceDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <!-- Legend swatches repeat the colors the drawings use, so both change with the tokens above. -->
    <Style x:Key="LegendItem" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="{StaticResource SpaceS}" />
        <Setter Property="Margin" Value="0,0,16,4" />
    </Style>
    <Style x:Key="LegendMeasure" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource GridBarLight}, Dark={StaticResource GridBarDark}}" />
        <Setter Property="WidthRequest" Value="2" />
        <Setter Property="HeightRequest" Value="12" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="LegendBeat" TargetType="BoxView" BasedOn="{StaticResource LegendMeasure}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource GridBeatLight}, Dark={StaticResource GridBeatDark}}" />
        <Setter Property="WidthRequest" Value="1" />
    </Style>
    <Style x:Key="LegendStrong" TargetType="BoxView" BasedOn="{StaticResource LegendMeasure}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource StrongBeatTintLight}, Dark={StaticResource StrongBeatTintDark}}" />
        <Setter Property="WidthRequest" Value="12" />
    </Style>
    <Style x:Key="LegendSubdivision" TargetType="BoxView" BasedOn="{StaticResource LegendMeasure}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource GridTickLight}, Dark={StaticResource GridTickDark}}" />
        <Setter Property="WidthRequest" Value="1" />
        <Setter Property="HeightRequest" Value="6" />
    </Style>
    <Style x:Key="LegendNote" TargetType="BoxView" BasedOn="{StaticResource LegendMeasure}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource NoteFillLight}, Dark={StaticResource NoteFillDark}}" />
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style x:Key="LegendSelected" TargetType="BoxView" BasedOn="{StaticResource LegendNote}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource SelectedFillLight}, Dark={StaticResource SelectedFillDark}}" />
    </Style>
</ResourceDictionary>
