<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Orchid.UiPreview.Theme">
    <!-- Tokens from docs/orchid-design/UI-SPEC.md. Drawings read the same tokens through PreviewColors. -->
    <Color x:Key="BackgroundLight">#F6F5F8</Color>
    <Color x:Key="BackgroundDark">#17171D</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#202027</Color>
    <Color x:Key="SubtleSurfaceLight">#F0EFF4</Color>
    <Color x:Key="SubtleSurfaceDark">#292932</Color>
    <Color x:Key="TextLight">#292735</Color>
    <Color x:Key="TextDark">#E9E7EF</Color>
    <Color x:Key="TextSecondaryLight">#706B7D</Color>
    <Color x:Key="TextSecondaryDark">#AAA5B8</Color>
    <Color x:Key="BorderLight">#E4E1EB</Color>
    <Color x:Key="BorderDark">#383640</Color>
    <Color x:Key="AccentLight">#755B9B</Color>
    <Color x:Key="AccentDark">#C1A8E4</Color>
    <Color x:Key="OnAccentLight">#FFFFFF</Color>
    <Color x:Key="OnAccentDark">#21142E</Color>
    <Color x:Key="NoteFillLight">#DCEBE4</Color>
    <Color x:Key="NoteFillDark">#29473C</Color>
    <Color x:Key="NoteTextLight">#2B5844</Color>
    <Color x:Key="NoteTextDark">#C3E3D0</Color>
    <Color x:Key="SelectedFillLight">#F7DDBA</Color>
    <Color x:Key="SelectedFillDark">#715133</Color>
    <Color x:Key="SelectedTextLight">#754A17</Color>
    <Color x:Key="SelectedTextDark">#FFE4BC</Color>
    <Color x:Key="MeasureLineLight">#B59A56</Color>
    <Color x:Key="MeasureLineDark">#BBAA71</Color>
    <Color x:Key="SubdivisionLineLight">#CBD8E7</Color>
    <Color x:Key="SubdivisionLineDark">#394454</Color>
    <!-- Piano keys are not in the spec table; the dark ivory is sampled from workspace-dark.png. -->
    <Color x:Key="KeyWhiteLight">#FFFFFF</Color>
    <Color x:Key="KeyWhiteDark">#D9D6E2</Color>
    <Color x:Key="KeyBlackLight">#393542</Color>
    <Color x:Key="KeyBlackDark">#393542</Color>
    <Color x:Key="KeyLabelLight">#292735</Color>
    <Color x:Key="KeyLabelDark">#292735</Color>

    <x:Double x:Key="FontCaption">11</x:Double>
    <x:Double x:Key="FontSecondary">12</x:Double>
    <x:Double x:Key="FontBody">14</x:Double>
    <x:Double x:Key="FontTitle">22</x:Double>
    <x:Double x:Key="FontDisplay">28</x:Double>

    <x:Double x:Key="SpaceXS">4</x:Double>
    <x:Double x:Key="SpaceS">8</x:Double>
    <x:Double x:Key="SpaceM">12</x:Double>
    <x:Double x:Key="SpaceL">16</x:Double>
    <x:Double x:Key="SpaceXL">24</x:Double>
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PanelPadding">16</Thickness>

    <!-- Lucide icons (ISC, docs/orchid-design/THIRD-PARTY-NOTICES.txt) as font glyphs, so they stay on real Buttons and follow the theme. -->
    <FontImageSource x:Key="IconRefresh" FontFamily="Lucide" Glyph="&#xE145;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconPlay" FontFamily="Lucide" Glyph="&#xE13C;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconPause" FontFamily="Lucide" Glyph="&#xE12E;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconRewind" FontFamily="Lucide" Glyph="&#xE15F;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconOpenLog" FontFamily="Lucide" Glyph="&#xE247;" Size="16" Color="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
    <FontImageSource x:Key="IconRecord" FontFamily="Lucide" Glyph="&#xE076;" Size="16" Color="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
    <FontImageSource x:Key="IconStop" FontFamily="Lucide" Glyph="&#xE167;" Size="16" Color="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
    <FontImageSource x:Key="IconFlower" FontFamily="Lucide" Glyph="&#xE2D4;" Size="24" Color="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>
    <Style x:Key="SecondaryLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontSecondary}" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="Label" BasedOn="{StaticResource SecondaryLabel}">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleSurfaceLight}, Dark={StaticResource SubtleSurfaceDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.45" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnAccentLight}, Dark={StaticResource OnAccentDark}}" />
        <Setter Property="BorderColor" Value="Transparent" />
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
    </Style>
    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleSurfaceLight}, Dark={StaticResource SubtleSurfaceDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>
    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleSurfaceLight}, Dark={StaticResource SubtleSurfaceDark}}" />
        <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="MaximumTrackColor" Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
    </Style>

    <!-- Legend swatches repeat the colors the drawings use, so both change with the tokens above. -->
    <Style x:Key="LegendItem" TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="{StaticResource SpaceS}" />
        <Setter Property="Margin" Value="0,0,16,4" />
    </Style>
    <Style x:Key="LegendMeasure" TargetType="BoxView">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource MeasureLineLight}, Dark={StaticResource MeasureLineDark}}" />
        <Setter Property="WidthRequest" Value="2" />
        <Setter Property="HeightRequest" Value="12" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="LegendBeat" TargetType="BoxView" BasedOn="{StaticResource LegendMeasure}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="WidthRequest" Value="1" />
    </Style>
    <Style x:Key="LegendSubdivision" TargetType="BoxView" BasedOn="{StaticResource LegendMeasure}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource SubdivisionLineLight}, Dark={StaticResource SubdivisionLineDark}}" />
        <Setter Property="WidthRequest" Value="1" />
    </Style>
    <Style x:Key="LegendNote" TargetType="BoxView" BasedOn="{StaticResource LegendMeasure}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource NoteFillLight}, Dark={StaticResource NoteFillDark}}" />
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style x:Key="LegendSelected" TargetType="BoxView" BasedOn="{StaticResource LegendNote}">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource SelectedFillLight}, Dark={StaticResource SelectedFillDark}}" />
    </Style>
</ResourceDictionary>
