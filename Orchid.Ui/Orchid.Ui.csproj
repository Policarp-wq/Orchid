<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- The plain net10.0 build compiles shared code without WinUI and runs Orchid.Ui.Tests on any OS. -->
        <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Orchid.Ui.Tests" />
        <MauiFont Include="Resources\Fonts\*" />
        <!-- MSBuild generates the strongly typed class, so no IDE designer file is needed. -->
        <EmbeddedResource Update="Theme\Strings.resx" StronglyTypedLanguage="C#" StronglyTypedClassName="Strings"
                          StronglyTypedNamespace="Orchid.Ui.Theme" StronglyTypedFileName="$(IntermediateOutputPath)Strings.Designer.cs" PublicClass="true" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    </ItemGroup>
</Project>
